{
  "expo": {
    "name": "D-Calendar",
    "slug": "NCALENDAR",
    "version": "1.0.1-alpha",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dcalendar",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0a0a0b",
    "ios": {
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#4E1F6E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 2,
      "package": "com.d1ito.NCALENDAR",
      "permissions": [
        "USE_EXACT_ALARM"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#4E1F6E",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#4E1F6E"
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "D-Calendar muestra los eventos de los calendarios que ya tienes en el dispositivo."
        }
      ],
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fa750b4d-2e95-4275-a62e-418ea76912b4"
      }
    }
  }
}
